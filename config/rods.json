{
  "config_file": "rods",
  "config_schema_version": 1,
  "balance_status": "PROVISIONAL",
  "description": "Rod definitions and upgrade costs. V0.1 implements Tier 0 (Starter Rod) and Tier 1 (Rod 1) only. The long-term tier ladder is recorded as reference data and intentionally has no rod entries.",
  "upgrade_rules": {
    "internal_levels": {
      "min": 1,
      "max": 10
    },
    "purchase_model": "Pay Coins to buy the next level directly.",
    "has_xp_bar": false,
    "has_failure_chance": false,
    "requires_materials": false,
    "uses_shells": false
  },
  "bonus_axes": {
    "note": "Only fishing-related bonuses exist. Bonuses are modest because small percentages compound over thousands of catches.",
    "rarity_efficiency": {
      "formula": "effective_weight(rare) = base_weight(rare) * (1 + rarity_efficiency)",
      "clamp_note": "Scales the rare slice of the existing pool weight. It can never introduce a rarity the map does not list in available_rarities, and a +5% efficiency must not turn a 1% chance into 6%."
    },
    "size_quality": {
      "formula": "draw_weight(large) and draw_weight(exceptional) are multiplied by (1 + size_quality); the remaining weight is renormalised."
    },
    "shell_yield": {
      "formula": "shell_drop_chance = base_chance * (1 + shell_yield)"
    }
  },
  "tier_ladder_reference": {
    "note": "Design ladder from GDD section 19. Rods 2-5 are out of V0.1 scope and intentionally not defined below.",
    "purchase_unlock_fisher_level": {
      "rod_01": 10,
      "rod_02": 30,
      "rod_03": 50,
      "rod_04": 70,
      "rod_05": 90
    }
  },
  "rods": [
    {
      "id": "rod_00_starter",
      "display_name": "Starter Rod",
      "tier": 0,
      "implemented_in_v0_1": true,
      "acquisition": {
        "method": "free_claim_in_shop",
        "purchase_cost_coins": 0,
        "unlock_fisher_level": 1
      },
      "has_internal_levels": false,
      "can_catch_rarities": [
        "common"
      ],
      "generates_shells": false,
      "bonuses": {
        "rarity_efficiency": 0.0,
        "size_quality": 0.0,
        "shell_yield": 0.0
      },
      "npc_resale_value_coins": 0,
      "tradable_on_market": false
    },
    {
