    "has_failure_chance": false,
    "requires_materials": false,
    "uses_shells": true,
    "uses_shells_note": "Desde 02/10/2026 (A-099) comprar e melhorar varas pede Conchas além das Moedas."
  },
  "bonus_axes": {
    "note": "Só existem bônus ligados à pesca. Os bônus são modestos porque percentuais pequenos se acumulam ao longo de milhares de capturas.",
    "rarity_efficiency": {
      "formula": "peso_efetivo(espécie não Comum) = peso_base × (1 + rarity_efficiency), só para as raridades que a vara pode pegar; os Comuns ficam iguais e o pool é renormalizado.",
      "clamp_note": "Escala a fatia não Comum (Raro e Épico) do peso já existente no pool. Nunca pode introduzir uma raridade que o mapa não lista em available_rarities, e uma eficiência de +5% não pode transformar uma chance de 1% em 6%."
    },
    "size_quality": {
      "formula": "draw_weight(grande) e draw_weight(excepcional) são multiplicados por (1 + size_quality); o peso restante é renormalizado."
    },
    "shell_yield": {
      "formula": "chance_de_concha = chance_base × (1 + shell_yield)"
    },
    "catch_success": {
      "formula": "pontos percentuais somados à Chance de Sucesso da Captura (0,05 = +5%), junto com a chance-base da raridade, o barco e a isca."
    }
  },
  "tier_ladder_reference": {
    "note": "Escada de progressão da seção 19 do GDD. As Varas 3 a 5 ainda não existem e de propósito não são definidas abaixo.",
