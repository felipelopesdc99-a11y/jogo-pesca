# ---------------------------------------------------------------------------
# Fishing Idle — local development environment
#
# Copy to .env at the repository root:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# Consumed by ops/docker-compose.yml, the API and the Development Console.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=fishing_idle
POSTGRES_USER=fishing_idle
# Local development password. Change it for anything that is not your own machine.
POSTGRES_PASSWORD=fishing_idle_dev
POSTGRES_HOST_PORT=5432

# --- Backend API ------------------------------------------------------------
API_HOST_PORT=5080
ASPNETCORE_ENVIRONMENT=Development

# Connection string the API uses. Inside Docker Compose the host is the service name "postgres";
# when running the API directly on your machine with `dotnet run`, use "localhost".
FISHINGIDLE_ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=fishing_idle;Username=fishing_idle;Password=fishing_idle_dev

# Browser origins allowed to call the API. Exact origins only, never a wildcard.
FISHINGIDLE_DevConsole__AllowedOrigins__0=http://localhost:3000
FISHINGIDLE_DevConsole__AllowedOrigins__1=http://127.0.0.1:3000

# --- Development Console ----------------------------------------------------
DEV_CONSOLE_HOST_PORT=3000
FISHING_IDLE_API_BASE_URL=http://localhost:5080

# --- Unity client -----------------------------------------------------------
# Optional. Overrides the backend URL compiled into the client's settings asset.
FISHING_IDLE_API_BASE_URL_CLIENT=http://localhost:5080
