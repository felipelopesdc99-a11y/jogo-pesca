# ---------------------------------------------------------------------------
# Fishing Idle — ambiente local de desenvolvimento
#
# Copie para .env na raiz do repositório:  cp .env.example .env
# O arquivo .env está no .gitignore. Nunca versione credenciais reais.
# É lido por ops/docker-compose.yml, pela API e pelo Painel de Desenvolvimento.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=fishing_idle
POSTGRES_USER=fishing_idle
# Senha de desenvolvimento local. Troque para qualquer coisa que não seja a sua própria máquina.
POSTGRES_PASSWORD=fishing_idle_dev
POSTGRES_HOST_PORT=5432

# --- API do backend ---------------------------------------------------------
API_HOST_PORT=5080
ASPNETCORE_ENVIRONMENT=Development

# String de conexão usada pela API. Dentro do Docker Compose o endereço é o nome do
# serviço, "postgres"; ao rodar a API direto na sua máquina com `dotnet run`, use "localhost".
FISHINGIDLE_ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=fishing_idle;Username=fishing_idle;Password=fishing_idle_dev

# Origens de navegador autorizadas a chamar a API. Apenas origens exatas, nunca curinga.
FISHINGIDLE_DevConsole__AllowedOrigins__0=http://localhost:3000
FISHINGIDLE_DevConsole__AllowedOrigins__1=http://127.0.0.1:3000

# --- Painel de Desenvolvimento ----------------------------------------------
DEV_CONSOLE_HOST_PORT=3000
FISHING_IDLE_API_BASE_URL=http://localhost:5080

# --- Cliente Unity ----------------------------------------------------------
# Opcional. Sobrepõe o endereço do servidor configurado no cliente.
FISHING_IDLE_API_BASE_URL_CLIENT=http://localhost:5080
