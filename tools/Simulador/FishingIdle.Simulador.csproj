<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Balance simulator (Milestone 11): plays the real game-service rules with a hand-driven clock and
    writes a PT-BR report of the current numbers. Run with ./ops/scripts/simular.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>FishingIdle.Simulador</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GameService.Build/GameService.Build.csproj" />
  </ItemGroup>
</Project>
