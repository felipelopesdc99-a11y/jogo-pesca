# --- Rodando de um clone na sua máquina ---------------------------------------
# Endereço base do backend do Fishing Idle. O painel lê o status do projeto a partir dele.
FISHING_IDLE_API_BASE_URL=http://localhost:5080

# Caminho absoluto da raiz do repositório, usado como fonte alternativa para docs/roadmap.json
# quando o backend está inacessível. Deixe vazio para o painel descobrir sozinho, subindo pastas.
FISHING_IDLE_REPO_ROOT=

# --- Rodando publicado, sem clone e sem backend --------------------------------
# Repositório e branch que o painel acompanha. Defina os dois ao publicar na Vercel,
# e NÃO defina FISHING_IDLE_API_BASE_URL nesse caso. Veja docs/PAINEL_ONLINE.md.
FISHING_IDLE_GITHUB_REPO=
FISHING_IDLE_GITHUB_BRANCH=

# Só necessário se o repositório for privado, ou para evitar o limite de 60 consultas
# por hora da API do GitHub. Token de leitura de conteúdo. Nunca versione o valor real.
FISHING_IDLE_GITHUB_TOKEN=
