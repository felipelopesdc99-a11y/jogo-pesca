{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fishing Idle development roadmap",
  "type": "object",
  "required": ["project", "target_version", "current_milestone", "statuses", "milestones"],
  "properties": {
    "$schema": { "type": "string" },
    "project": { "type": "string" },
    "target_version": { "type": "string" },
    "updated_at": { "type": "string" },
    "current_milestone": { "type": "string" },
    "statuses": {
      "type": "array",
      "items": { "enum": ["TODO", "IN_PROGRESS", "DONE", "BLOCKED", "NEEDS_OWNER_DECISION"] }
    },
    "notes": { "type": "string" },
    "owner_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "detail", "status"],
        "properties": {
          "id": { "type": "string" },
          "task_id": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "raised_at": { "type": "string" },
          "status": { "enum": ["OPEN", "RESOLVED"] },
          "resolution": { "type": "string" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "tasks"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]+$" },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "completion_criteria": { "type": "array", "items": { "type": "string" } },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "subsystem", "description", "status", "dependencies", "updated_at"],
              "properties": {
                "id": { "type": "string", "pattern": "^M[0-9]+-T[0-9]{2}$" },
                "title": { "type": "string" },
                "subsystem": { "enum": ["repo", "docs", "config", "ops", "server", "client", "web"] },
                "description": { "type": "string" },
                "status": { "enum": ["TODO", "IN_PROGRESS", "DONE", "BLOCKED", "NEEDS_OWNER_DECISION"] },
                "dependencies": { "type": "array", "items": { "type": "string" } },
                "completion_notes": { "type": "string" },
                "updated_at": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
